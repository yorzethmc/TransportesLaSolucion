# ==============================================================================
# TRANSPORTES LA SOLUCIÓN - VARIABLES DE ENTORNO UNIFICADAS (EJEMPLO)
# ==============================================================================

# SUPABASE - CREDENCIALES DE ACCESO (ESTÁNDAR 2026: PUBLISHABLE & SECRET KEYS)
# URL de proyecto Supabase
SUPABASE_URL=https://xyzcompany.supabase.co

# Clave pública publishable (Segura para public-web, admin-dashboard y driver-app)
# Formato: sb_publishable_...
SUPABASE_PUBLISHABLE_KEY=sb_publishable_example_token_2026

# Clave secreta administrativa (ESTRICTAMENTE PRIVADA)
# Uso exclusivo en Edge Functions seguras y secretos de GitHub Actions CI/CD.
# Formato: sb_secret_...
SUPABASE_SECRET_KEY=sb_secret_example_token_2026

# BASE DE DATOS DIRECTA (POSTGRESQL / POOLER)
DATABASE_URL=postgresql://postgres.xyzcompany:YourStrongPassword123@aws-0-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres.xyzcompany:YourStrongPassword123@aws-0-us-east-1.pooler.supabase.com:5432/postgres

# CONFIGURACIÓN OPERATIVA DE FLOTA
DEFAULT_GPS_INTERVAL_MS=300000
MAX_ACTIVE_DRIVERS=10
GPS_MAX_ACCURACY_METERS=50
GPS_MAX_VALID_SPEED_KMH=140

# CONFIGURACIÓN DE APLICACIONES FRONTEND (VITE)
VITE_SUPABASE_URL=https://xyzcompany.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_example_token_2026
VITE_APP_ENV=development
