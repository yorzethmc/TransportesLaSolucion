# ==============================================================================
# TRANSPORTES LA SOLUCIÓN - VARIABLES DE ENTORNO UNIFICADAS (EJEMPLO)
# ==============================================================================

# SUPABASE - CREDENCIALES DE ACCESO
# La URL de tu proyecto Supabase (local o en la nube)
SUPABASE_URL=https://xyzcompany.supabase.co

# Clave pública anónima (Safe to expose in frontend / APK)
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.example_anon_key

# Clave administrativa de servicio (NUNCA EXPONER EN FRONTEND, APK NI REPOSITORIO)
# Solo para uso en scripts DevOps, CI/CD o Supabase Edge Functions seguras
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.example_service_role_key

# BASE DE DATOS DIRECTA (POSTGRESQL / POOLER)
DATABASE_URL=postgresql://postgres.xyzcompany:YourStrongPassword123@aws-0-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres.xyzcompany:YourStrongPassword123@aws-0-us-east-1.pooler.supabase.com:5432/postgres

# CONFIGURACIÓN OPERATIVA DE FLOTA
DEFAULT_GPS_INTERVAL_MS=300000
MAX_ACTIVE_DRIVERS=10
GPS_MAX_ACCURACY_METERS=50
GPS_MAX_VALID_SPEED_KMH=140

# CONFIGURACIÓN DE APLICACIONES FRONTEND
VITE_SUPABASE_URL=https://xyzcompany.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.example_anon_key
VITE_APP_ENV=development
