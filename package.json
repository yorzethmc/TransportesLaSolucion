{
  "name": "transportes-la-solucion",
  "version": "1.0.0",
  "private": true,
  "description": "Plataforma de transporte privado VIP y gestión de flotas para Transportes La Solución",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "vitest run",
    "test:all": "vitest run && npx supabase test db",
    "test:db": "npx supabase test db",
    "lint": "npm run lint --workspaces --if-present",
    "clean": "npm run clean --workspaces --if-present"
  },
  "keywords": [
    "transport",
    "logistics",
    "postgis",
    "supabase",
    "react",
    "capacitor"
  ],
  "author": "Transportes La Solución",
  "license": "UNLICENSED",
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^5.7.3",
    "vitest": "^4.1.11"
  }
}
